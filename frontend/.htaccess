# MIME types for PWA assets. Apache doesn't ship with mappings for these
# extensions, which makes Chrome warn (and Lighthouse fail the PWA audit).
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
    AddType image/svg+xml .svg
</IfModule>

# Don't cache the service worker registration script — browsers should
# always check for a fresh copy so SW updates roll out immediately.
<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # Allow specific parent origins to embed gpt/frontend in an iframe (used by
    # PortfolioManagement's AI Assistant page). frame-ancestors works at origin
    # level only — path-level enforcement happens in the postMessage handshake.
    # Add prod domains here as they come online.
    <FilesMatch "\.html$">
        Header set Content-Security-Policy "frame-ancestors 'self' https://finmind.org http://localhost:3000"
        Header unset X-Frame-Options
    </FilesMatch>
</IfModule>

# ─────────────────────────────────────────────────────────────────────────────
# backend/.env — local secrets and environment for the PHP backend
#
#   cp .env.example .env     then fill in the values below
#
# .env is gitignored and MUST stay that way: this repo is public. Nothing in
# this example file may ever hold a real value — it documents names, not keys.
#
# Loaded by config/load_env.php, which ABORTS at startup if any variable in the
# REQUIRED block is missing or empty. Everything after that block is optional:
# leave it blank and the feature that uses it stays off.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────
# Without these ten the backend refuses to boot (config/load_env.php).

# Main application database (users, sessions, usage).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# CONTEXTS database — the chatbot data lives here, NOT in the main DB above:
# agents, workflows, playbooks, app keys and system_llm_settings. A standalone
# script that uses $config['database'] is talking to the wrong one.
CTX_DB_HOST=localhost
CTX_DB_NAME=
CTX_DB_USER=
CTX_DB_PASS=

# Signs and verifies the session JWT. Any long random string; rotating it logs
# everyone out.            openssl rand -hex 32
JWT_SECRET=

# Server-side pepper for per-user app keys. Rotating it invalidates every app
# key already issued, so set it once and keep it.    openssl rand -hex 32
APP_KEY_SECRET=

# ── LLM PROVIDER KEYS — read this before adding any ─────────────────────────
# Chat and workflows do NOT read provider keys from here. They come from the
# system_llm_settings table in the CONTEXTS database, edited in the app under
# Admin → LLM settings, which is also what the workflow editor syncs into the
# local Python runner's .env when it compiles a workflow.
#
# The variables below are FALLBACKS only, used when a provider row is missing
# or empty (e.g. Configuration.php's OpenAI block, the memory auto-updater's
# ANTHROPIC_API_KEY). Prefer the admin UI; set these only for a headless box.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
# GLM 5.2 (z.ai / Zhipu) — OpenAI-compatible, base_url https://api.z.ai/api/paas/v4
GLM_API_KEY=
# Overrides the default model for the Claude fallback path only.
CLAUDE_MODEL=

# ── SEARCH / DATA TOOLS (optional) ──────────────────────────────────────────
# Each powers one tool; blank = that tool is unavailable, nothing else breaks.
SERPAPI_KEY=          # serpapi.com            — Google results
SCRAPINGDOG_KEY=      # scrapingdog.com        — Google results (cheaper alt)
BRAVE_KEY=            # brave.com/search/api   — Brave results
FMP_KEY=              # financialmodelingprep.com — stock/financial data

# ── VOICE (optional) ────────────────────────────────────────────────────────
HUME_API_KEY=         # platform.hume.ai — empathic voice
GROK_VOICE_API_KEY=   # xAI realtime voice
GEMINI_VOICE_API_KEY= # Google realtime voice

# ── SCHEDULER (optional) ────────────────────────────────────────────────────
# Shared secret an external cron must present to trigger scheduled workflows
# over HTTP. Blank disables the HTTP trigger.        openssl rand -hex 32
SCHEDULER_TOKEN=

# ── VECTOR STORE (optional, RAG ingestion) ──────────────────────────────────
# Postgres + pgvector. Placeholder below — replace user/pass/host/db.
VECTOR_DB_DSN=postgresql+psycopg://user:pass@localhost:5432/vectordb

# ── SOCIAL LOGIN (optional) ─────────────────────────────────────────────────
# Firebase project id — a PUBLIC value, used to verify the aud/iss claims of
# social-login ID tokens. Not a secret.
FIREBASE_PROJECT_ID=transledgersite

# ── SSO WITH THE LOGIN MICROSERVICE (optional) ──────────────────────────────
# Only needed when gpt_admin signs in through the login service. Copy these
# three from login/backend/.env — they must match exactly or SSO silently fails.
LOGIN_JWT_SECRET=
LOGIN_DB_USER=
LOGIN_DB_PASS=
# Default to the main DB host/name when blank.
LOGIN_DB_HOST=
LOGIN_DB_NAME=

# ── VIDEO-EDIT DATABASE (optional) ──────────────────────────────────────────
# Only for the video-edit feature; blank leaves it disabled.
VE_DB_HOST=
VE_DB_NAME=
VE_DB_USER=
VE_DB_PASS=

# ── DEV TOGGLES (optional) ──────────────────────────────────────────────────
STORAGE_PROVIDER=local   # where generated files go; 'local' unless you have another
AI_DEBUG=                # any non-empty value turns on verbose AI logging

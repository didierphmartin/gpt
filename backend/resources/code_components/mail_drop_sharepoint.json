{
  "name": "Mail drop → SharePoint",
  "exits": ["filed", "error", "idle"],
  "mcp_servers": ["Outlook", "SharePoint"],
  "timeout_s": 300,
  "start_trigger": {
    "label": "Mail dropped in a folder",
    "watch": {"server": "Outlook", "tool": "wait_for_new", "args": {"poll": "poll_new_mail", "mode": "drop", "folder": "To SharePoint"}},
    "work_exit": "filed",
    "pass_args": ["folder"]
  }
}

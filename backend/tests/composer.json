{
    "name": "quantis/ai-portfolio-assistant",
    "description": "AI-powered portfolio analysis assistant with Claude integration, streaming SSE support, and extensible function calling",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Didier Martin",
            "email": "didierphmartin@example.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "nikic/fast-route": "^1.3",
        "psr/log": "^3.0",
        "simplepie/simplepie": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Quantis\\AIPortfolioAssistant\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Quantis\\AIPortfolioAssistant\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "keywords": [
        "ai",
        "claude",
        "portfolio",
        "assistant",
        "anthropic",
        "llm",
        "chatbot",
        "finance",
        "investment"
    ]
}

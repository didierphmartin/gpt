# ─────────────────────────────────────────────────────────────────────────────
# backend_python/.env — the FastAPI twin of the PHP backend
#
#   cp .env.example .env     then fill it in
#
# .env is gitignored and must stay that way: this repo is public. Keep this
# example free of real values.
#
# PHP is the reference implementation (docs/backend-parity-tracker.md); this is
# a port. Every shared value must be IDENTICAL to ../backend/.env — the two read
# the same databases and must accept each other's tokens.
#
# CONVENIENCE: if this file is absent, the app falls back to reading
# ../backend/.env directly, so a local dev box usually needs no .env here at all.
# Create one only to override something (a different PORT, CORS origins).
#
# Start the server with ./run.sh (it is not started for you).
# ─────────────────────────────────────────────────────────────────────────────

# ── PYTHON-ONLY ─────────────────────────────────────────────────────────────

# Port this backend listens on (PHP under Apache, Node on 3001).
PORT=3002

# PHP's date.timezone from XAMPP's php.ini. Used so date formatting matches the
# PHP backend exactly — the differential tests compare timestamps.
PHP_TIMEZONE=Europe/Berlin

# Comma-separated origins allowed to make credentialed cross-origin calls.
# Blank = echo back any Origin, which suits a LAN-only deployment. PHP is
# same-origin and needs no equivalent.
CORS_ALLOWED_ORIGINS=

# ── SHARED WITH ../backend/.env — use the SAME values ───────────────────────

# Main database.
DB_HOST=
DB_NAME=
DB_USER=
DB_PASS=

# CONTEXTS database — the chatbot data (agents, workflows, playbooks, app keys,
# system_llm_settings) lives here, not in the main DB above.
CTX_DB_HOST=
CTX_DB_NAME=
CTX_DB_USER=
CTX_DB_PASS=

# Auth. MUST match ../backend/.env or tokens will not cross between backends.
JWT_SECRET=
APP_KEY_SECRET=

# SSO with the login microservice (optional).
LOGIN_JWT_SECRET=
LOGIN_DB_HOST=
LOGIN_DB_NAME=
LOGIN_DB_USER=
LOGIN_DB_PASS=

# Video-edit database (optional).
VE_DB_HOST=
VE_DB_NAME=
VE_DB_USER=
VE_DB_PASS=

# Search / data tools (optional). Blank = that tool is unavailable.
SERPAPI_KEY=
SCRAPINGDOG_KEY=
BRAVE_KEY=
FMP_KEY=

# Voice (optional).
HUME_API_KEY=
GROK_VOICE_API_KEY=
GEMINI_VOICE_API_KEY=

# Shared secret for the HTTP scheduler trigger (optional).
SCHEDULER_TOKEN=

# Firebase project id — a PUBLIC value, verifies social-login token aud/iss.
FIREBASE_PROJECT_ID=transledgersite

# ── LLM PROVIDER KEYS — fallbacks only ──────────────────────────────────────
# Chat and workflows read provider keys from the system_llm_settings table in
# the CONTEXTS database (Admin → LLM settings). These are used only where a
# provider row is missing or empty. Prefer the admin UI.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
CLAUDE_MODEL=

# ── LOCAL EXECUTION PATHS (optional) ────────────────────────────────────────
# Where generated documents are written. Defaults to ~/Documents/synergyAI/outputs.
SYNERGYAI_OUTPUT_ROOT=
# Scratch space for skill runs. Defaults to a temp directory.
SYNERGYAI_SCRATCH_DIR=
# Directory the browser-side skill bridge exchanges files through.
SKILL_TOOL_BRIDGE_DIR=
# How unattended playbook gates resolve when no human is watching:
# auto (default) | deny | prompt. 'prompt' needs a terminal.
PLAYBOOK_GATE_MODE=
# Where generated files go; 'local' unless another provider is configured.
STORAGE_PROVIDER=local
# Any non-empty value turns on verbose AI logging.
AI_DEBUG=

# Copy to .env to change any of these. Every value has a working default,
# so `docker compose up` works with no .env at all.

# Where the app is published on your machine.
GPT_PORT=8080

# Database. These are container-local; nothing outside Docker uses them.
MYSQL_DATABASE=gpt_chatbot
MYSQL_USER=gpt
MYSQL_PASSWORD=gpt
MYSQL_ROOT_PASSWORD=root

# First admin. Leave the password blank and one is generated on first boot and
# printed to the container log (`docker compose logs web`).
GPT_ADMIN_EMAIL=admin@localhost
GPT_ADMIN_PASSWORD=

# LLM provider keys do NOT go here, and nothing in this stack reads them from
# the environment. Add your keys in the running app, under
# Settings -> Admin -> LLM settings.

# Copy to .env to change any of these. Every value has a working default,
# so `docker compose up` works with no .env at all.

# ── EDITION ─────────────────────────────────────────────────────────────────
# Not set here. The compose files choose it:
#   docker compose up                                   -> individual
#   docker compose -f compose.yaml -f compose.corporate.yaml up
#                                                       -> corporate
# individual = free, single user, NO sign-in screen. The container signs you in
#              and the first-run wizard asks for your own LLM provider keys.
# corporate  = users sign in, gpt_admin manages them (needs the gpt_admin repo,
#              a separate private checkout, and a commercial licence).

# ── WHERE IT LISTENS ────────────────────────────────────────────────────────
# WARNING: this publishes on every network interface (0.0.0.0), not just
# localhost. In the individual edition, anyone who can reach GPT_PORT --
# including another machine on your LAN, not just this one -- gets the
# plaintext admin password and is logged in as admin with no sign-in screen
# at all. That password is also printed to `docker compose logs web` in
# plain text. If this host is reachable from anyone you don't trust, restrict
# it to localhost:
# GPT_BIND=127.0.0.1
GPT_PORT=8080

# ── DATABASE (container-local; nothing outside Docker uses these) ────────────
MYSQL_DATABASE=gpt_chatbot
MYSQL_USER=gpt
MYSQL_PASSWORD=gpt
MYSQL_ROOT_PASSWORD=root

# ── THE FIRST ACCOUNT ────────────────────────────────────────────────────────
# Individual edition only. You never type these -- the container signs you in
# with them. Leave the password blank and one is generated on first boot and
# kept in the gpt-secrets volume, so it survives restarts.
# Corporate edition: not used. The corporate admin account is created by the
# setup wizard in gpt_admin, on first visit -- not from .env.
GPT_ADMIN_EMAIL=admin@localhost
GPT_ADMIN_PASSWORD=

# Corporate only: your gpt_admin checkout (a separate, private repository).
# NOTE: setting it here has no effect on the build -- it names a build
# *context* on disk, and only `docker build`'s shell command line can pass
# that (docker compose reads .env, but nothing consumes this key from it).
# `export GPT_ADMIN_SRC=../gpt_admin` in your shell instead -- see the
# README's Editions section for the full four-command build.
GPT_ADMIN_SRC=../gpt_admin

# Corporate only: your login service checkout (a separate, private
# repository). Same rule as GPT_ADMIN_SRC above: setting it here has no
# effect on the build. `export GPT_LOGIN_SRC=../login` in your shell instead.
GPT_LOGIN_SRC=../login

# ── LLM PROVIDER KEYS DO NOT GO HERE ────────────────────────────────────────
# Nothing in this stack reads a provider key from the environment. Enter yours
# in the app: the first-run wizard's "API keys" step (individual), or later
# under Settings -> Admin -> LLM settings.

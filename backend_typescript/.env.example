# Port the TS backend listens on (the PHP backend is served by Apache under /gpt/backend).
PORT=3001

# Main MySQL database — SAME values as the PHP backend's .env (DB_*).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

# Contexts MySQL database — SAME values as the PHP backend's .env (CTX_DB_*).
# Controllers in PHP receive the contexts DB as their primary PDO ($config['contexts_database'] ?? $config['database']).
CTX_DB_HOST=localhost
CTX_DB_NAME=
CTX_DB_USER=
CTX_DB_PASS=
CTX_DB_PORT=3306

# Auth — MUST match the PHP backend so tokens issued by either are accepted by both.
JWT_SECRET=
APP_KEY_SECRET=

# CORS allowed origin (frontend). Mirror the PHP backend's policy.
CORS_ALLOW_ORIGIN=*

# Firebase project id (public) used to verify social-login ID tokens (aud/iss).
# Defaults to the frontend's project if unset.
FIREBASE_PROJECT_ID=transledgersite

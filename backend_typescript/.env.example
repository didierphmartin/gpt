# ─────────────────────────────────────────────────────────────────────────────
# backend_typescript/.env — the TypeScript twin of the PHP backend
#
#   cp .env.example .env     then fill it in
#
# .env is gitignored and must stay that way: this repo is public. Keep this
# example free of real values.
#
# PHP is the reference implementation (docs/backend-parity-tracker.md); this
# backend is a port. Nearly every value below must be IDENTICAL to
# ../backend/.env — a token minted by one backend has to verify in the other,
# and both read the same two databases. Where they differ, it is noted.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Port this backend listens on. PHP is served by Apache under /gpt/backend;
# the Python twin defaults to 3002.
PORT=3001

# Main MySQL database — SAME values as ../backend/.env (DB_*).
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_PORT=3306

# CONTEXTS MySQL database — SAME values as ../backend/.env (CTX_DB_*).
# This is where the chatbot data lives (agents, workflows, playbooks, app keys,
# system_llm_settings), and it is the PRIMARY connection the controllers get.
CTX_DB_HOST=localhost
CTX_DB_NAME=
CTX_DB_USER=
CTX_DB_PASS=
CTX_DB_PORT=3306

# Auth — MUST match ../backend/.env exactly, or a session issued by one backend
# is rejected by the other.
JWT_SECRET=
APP_KEY_SECRET=

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Per-user app keys. Falls back to APP_KEY_SECRET when blank; set it only if
# the PHP side sets it too.
USER_APP_KEY_SECRET=

# CORS allowed origin for the frontend. Mirror the PHP backend's policy.
# '*' is fine on a LAN-only deployment; name the origin when exposed.
CORS_ALLOW_ORIGIN=*

# Firebase project id (a PUBLIC value) used to verify the aud/iss claims of
# social-login ID tokens.
FIREBASE_PROJECT_ID=transledgersite

# Where Google's public signing certs are fetched from. Leave blank for the
# default endpoint; override only to pin a mirror.
FIREBASE_CERTS_URL=

# Shared secret an external cron presents to trigger scheduled workflows.
# SAME value as ../backend/.env; blank disables the HTTP trigger.
SCHEDULER_TOKEN=

# Voice providers. Blank = that provider stays off.
HUME_API_KEY=
HUME_BASE_URL=
HUME_CONFIG_ID=
GROK_VOICE_API_KEY=
GROK_VOICE_BASE_URL=
GEMINI_VOICE_API_KEY=

# TS-only: mirrors every console.* line to this file (the twin of PHP's
# error_log). Relative paths resolve from the backend root. Keep it OUT of the
# repo — logs have carried real conversation content before.
BACKEND_LOG_FILE=logs/backend.log

# TS-only: path to the model catalog JSON. Blank uses the bundled default.
MODEL_CATALOG_PATH=

# NOTE — LLM provider keys are NOT here. They live in the system_llm_settings
# table of the CONTEXTS database, edited under Admin → LLM settings, exactly as
# in the PHP backend.

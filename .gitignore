backend/.env

# Frontend config (Firebase web config + provider keys)
frontend/assets/js/config.js
frontend/voice/config.json

# Catch-alls for any other secret/config the project may add
**/.env
**/.env.*
!**/.env.example
**/*.local.php
*.pem
*.key
*.p12
*.pfx
id_rsa*
**/serviceAccount*.json


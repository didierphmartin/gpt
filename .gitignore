# ───────────────── OS / editor ─────────────────
.DS_Store
**/.DS_Store
*.swp
Thumbs.db

# ───────────────── Scratch / caches / test artifacts ─────────────────
.scratch_parity/
backend/.phpunit.result.cache
frontend/test-results/

# Local Claude Code settings
.claude/settings.local.json

# ───────────────── Secrets / live config ─────────────────
# Secrets live ONLY in backend/.env (gitignored). The ai_config.php files are now
# secret-free (they read $_ENV) and ARE committed. Copy backend/.env.example → backend/.env.
backend/.env

# Frontend config (Firebase web config + provider keys)
frontend/assets/js/config.js
frontend/voice/config.json

# Catch-alls for any other secret/config the project may add
**/.env
**/.env.*
!**/.env.example
**/*.local.php
*.pem
*.key
*.p12
*.pfx
id_rsa*
**/serviceAccount*.json

# ───────────────── Runtime / user data ─────────────────
backend/storage/

# ───────────────── Build artifacts ─────────────────
frontend/voice/assets/
**/dist/
**/.next/

# ───────────────── Dependencies ─────────────────
**/vendor/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc

# Nested git repo (vendored library)
frontend/driver.js/.git/

# ───────────────── Logs / temp ─────────────────
*.log
# PHP's error_log has no extension, so *.log never caught it. It was
# committed for months and carried real conversation content (user
# prompts, assistant replies, user ids, per-call token cost) into a
# PUBLIC repo. Any path, any depth.
**/error_log
*.tmp
tmp/

# Vendored library with its own git repo (install separately)
frontend/driver.js/

# Runtime-generated ingestion scripts (Plan 1)
langchain_runner/ingestion_*.py
# ...but the vendored splitter is real source, not generated
!langchain_runner/ingestion_splitter.py
langchain_runner/ingestion.log

# ───────────────── Not published ─────────────────
# Kept local: working notes, the agent harness, and sub-projects that ship
# from elsewhere. Adding a path here does nothing on its own — anything
# already committed also needs `git rm -r --cached <path>`.

# Claude Code's workspace (settings, agents, skills).
.claude/

# Docs and working notes, INCLUDING docs/superpowers (plans + specs).
# The run-protocol contract used to live here and had to be carved out; it now
# sits at backend/schema/run-protocol-v1.json, where a file the test suite
# LOADS at run time belongs. So this can exclude the whole folder.
docs/

# The local Python runner's source. setup.py copies it to
# ~/Documents/synergyAI/python/; it is not part of the web app.
langchain_runner/

# Mobile PRD / scratch.
mobile/

# Anything checked out under an XAMPP path by accident.
xampp/
